# Builds the documentation site published on GitHub Pages
# (.github/workflows/pages.yml). Jekyll 4 is needed because the docs must be
# rendered without Liquid (see _config.yml), which Jekyll 3 cannot switch off.
source "https://rubygems.org"

gem "jekyll", "~> 4.4"
gem "jekyll-theme-primer", "~> 0.6"

group :jekyll_plugins do
  gem "jekyll-default-layout", "~> 0.2"
  gem "jekyll-optional-front-matter", "~> 0.3"
  gem "jekyll-readme-index", "~> 0.5"
  gem "jekyll-relative-links", "~> 0.9"
  gem "jekyll-seo-tag", "~> 2.9"
  gem "jekyll-titles-from-headings", "~> 0.5"
end
