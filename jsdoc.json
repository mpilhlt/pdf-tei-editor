{
  "source": {
    "include": ["app/src/modules"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules|dist|build)"
  },
  "opts": {
    "destination": "docs/api/frontend",
    "recurse": true,
    "encoding": "utf8",
    "readme": "docs/api/frontend-readme.md"
  },
  "plugins": ["plugins/markdown"]
}
