#!/usr/bin/env python3

# CLI for running the FastAPI server in development mode with auto-reload.

import os
import sys
import subprocess
from pathlib import Path

# Add project root to path for imports
project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project_root))

from fastapi_app.lib.utils.server_startup import (
    load_environment,
    check_port_in_use,
    get_pid_on_port,
    get_host_and_port,
    setup_log_directory,
    print_server_running_message,
    print_server_starting_message,
    kill_server_on_port
)
from fastapi_app.lib.plugins.plugin_paths import get_plugin_reload_dirs
from fastapi_app.lib.plugins.plugin_site import get_site_dir
from fastapi_app.lib.core.worker_recycle import DEV_RELOAD_TRIGGER_ENV_VAR


if __name__ == '__main__':
    # Load environment variables
    load_environment(project_root)

    # Check for --restart flag and remove it from sys.argv before parsing host/port
    restart = '--restart' in sys.argv
    if restart:
        sys.argv.remove('--restart')

    # Get host and port
    host, port = get_host_and_port()

    # Check if server is already running
    if check_port_in_use(port):
        if restart:
            kill_server_on_port(port)
        else:
            pid = get_pid_on_port(port)
            print_server_running_message(host, port, pid)
            sys.exit(0)

    # Generate the plugin and module registries, the importmap and the highlight.js bundle,
    # which are not under version control and are needed to load the frontend from source
    try:
        subprocess.run(['npm', 'run', '--silent', 'generate'], cwd=project_root, check=True, shell=sys.platform == 'win32')
    except (OSError, subprocess.CalledProcessError) as e:
        print(f"Generating the frontend source files failed ({e}). Run `npm install` and try again.", file=sys.stderr)
        sys.exit(1)

    # Set up logging
    log_file = setup_log_directory(project_root)

    # On Windows, uvicorn's auto-reload doesn't work properly - it shuts down but doesn't restart
    # See: https://github.com/fastapi/fastapi/discussions/13817
    # Disable auto-reload by default on Windows unless explicitly enabled
    if sys.platform == 'win32':
        disable_reload_default = os.environ.get('ENABLE_RELOAD', '').lower() not in ('1', 'true', 'yes')
    else:
        disable_reload_default = os.environ.get('DISABLE_RELOAD', '').lower() in ('1', 'true', 'yes')

    disable_reload = disable_reload_default

    print_server_starting_message(host, port, log_file, mode="development", auto_reload=not disable_reload)

    # Build uvicorn command
    log_config = str(project_root / 'fastapi_app' / 'log_config.json')
    cmd = [
        'uv', 'run', 'uvicorn',
        'run_fastapi:app',
        '--host', host,
        '--port', str(port),
        '--log-level', 'info',
        '--log-config', log_config,
        '--timeout-graceful-shutdown', '1',  # Force reload after 1 second if connections don't close
        '--reload-delay', '0.25'  # Debounce rapid file changes
    ]

    if not disable_reload:
        cmd.insert(3, '--reload')
        # Uvicorn's default ".*" exclude only matches the file name, so files inside dot-directories
        # (.claude, .git, .venv, ...) would still trigger reloads. Exclude them by absolute path.
        for dot_dir in sorted(project_root.glob('.*')):
            if dot_dir.is_dir():
                cmd.extend(['--reload-exclude', str(dot_dir)])
        # Plugins installed in the plugin manager are unpacked into the site directory. Changes
        # there must not reload the server: an "Upgrade all" would be interrupted after the first
        # plugin. The plugin manager restarts the server once by writing to a trigger file
        # (see fastapi_app/lib/core/worker_recycle.py). Uvicorn excludes only existing directories.
        site_dir = get_site_dir().resolve()
        site_dir.mkdir(parents=True, exist_ok=True)
        cmd.extend(['--reload-exclude', str(site_dir)])
        reload_trigger = site_dir.parent / 'dev-reload-trigger.py'
        os.environ[DEV_RELOAD_TRIGGER_ENV_VAR] = str(reload_trigger)
        # Also reload on changes to plugins outside the project (FASTAPI_PLUGIN_PATHS, editable
        # installs of a plugin checkout) and on the trigger file. With --reload-dir, uvicorn
        # watches only the listed directories, so the project root is listed too.
        plugin_dirs = get_plugin_reload_dirs(project_root)
        extra_dirs = [*plugin_dirs]
        if not reload_trigger.parent.is_relative_to(project_root):
            extra_dirs.append(reload_trigger.parent)
        if extra_dirs:
            for watched_dir in [project_root, *extra_dirs]:
                cmd.extend(['--reload-dir', str(watched_dir)])
        if plugin_dirs:
            print(f"Also watching {len(plugin_dirs)} plugin directories outside the project for changes")

    try:
        # Run uvicorn and stream output to log file
        with open(log_file, 'w', buffering=1) as log_f:
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                cwd=str(project_root)
            )

            # Stream output to both console and log file
            for line in process.stdout: # type:ignore
                print(line, end='')
                log_f.write(line)
                log_f.flush()

            process.wait()

    except KeyboardInterrupt:
        print("\nShutting down FastAPI server...")
        if 'process' in locals() and hasattr(process, 'terminate'):
            process.terminate()
            process.wait()
    except Exception as e:
        print(f"Error starting FastAPI server: {e}", file=sys.stderr)
        sys.exit(1)
