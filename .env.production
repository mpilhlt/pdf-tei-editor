# PDF-TEI Editor Production Configuration
# Copy this file to .env for production deployment

# =============================================================================
# Server Configuration
# =============================================================================

# Server host binding
# Default: 127.0.0.1
# For production, consider 0.0.0.0 to accept external connections
# HOST=0.0.0.0

# Server port binding
# Default: 8000
# PORT=8000

# Session timeout in seconds
# Default: 3600 (1 hour)
# SESSION_TIMEOUT=3600

# =============================================================================
# Application Mode
# =============================================================================

# Application mode: production
# FASTAPI_APPLICATION_MODE=production

# =============================================================================
# Access Control Configuration
# =============================================================================

# Document-level access control mode
# Overrides config.json 'access-control.mode' setting when set
# Valid values: role-based, owner-based, granular
# - role-based: Standard role-based permissions (default)
# - owner-based: Only document owner can edit
# - granular: Per-document visibility/editability settings
# Default: (uses config.json setting, which defaults to role-based)
# ACCESS_CONTROL_MODE=role-based

# =============================================================================
# Data Storage Configuration
# =============================================================================

# Root directory containing files/ and db/ subdirectories
# Default: data
# DATA_ROOT=data

# Directory for file uploads
# Default: System temp directory + /pdf-tei-editor-uploads
# UPLOAD_DIR=

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Recommended for production: WARNING or ERROR
# LOG_LEVEL=WARNING

# Comma-separated logging categories to enable
# Default: (empty - all categories)
# LOG_CATEGORIES=

# Log directory for application and server logs
# Default: ./log (project_root/log)
# For production, consider a dedicated log directory like /var/log/pdf-tei-editor
# LOG_DIR=

# =============================================================================
# Inference Provider API Keys
# =============================================================================

# API keys of inference providers (Anthropic Claude, Google Gemini, KISSKI, ...)
# are not configured here. Each user enters their own keys in the web interface
# (user menu > API Keys, or the prompt shown when a key is missing); they are
# stored encrypted in data/db/secrets.db. Administrators can manage them with
# bin/user-secrets.py (see docs/user-manual/cli.md#user-api-keys).

# Fernet key that encrypts the stored API keys
# Set it in production. Without it, a key is generated once and kept in
# data/db/secrets.key, next to the encrypted keys: every copy of the data
# directory (backups, sync mirrors, the Docker volume) can then decrypt them,
# and the server logs a warning. Keep the key: losing it makes all stored keys
# unreadable.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEY=

# =============================================================================
# Plugin System
# =============================================================================

# Which plugins are installed is decided by `uv sync --extra ...` or, for the
# Docker image, by the build argument PTE_PLUGIN_EXTRAS (not an environment
# variable of the running container); see docs/user-manual/docker-deployment.md.

# Directories with additional (external) plugins, separated by ':' (';' on Windows)
# Each directory is searched for plugins (a directory with plugin.py and pte-plugin.json)
# Default: (empty)
# FASTAPI_PLUGIN_PATHS=

# Allow administrators to discover and install plugins from GitHub releases
# in the plugin manager ("Available" tab). Installed plugins run with full
# access to all data, so this is off unless the operator enables it.
# Set to 'true', '1', 'yes' or 'on' to enable
# Default: off
# PTE_PLUGIN_INSTALL=1

# Plugin repositories (owner/repo) that are always listed, separated by commas
# Default: mpilhlt/pte-plugins
# PTE_PLUGIN_SOURCES=mpilhlt/pte-plugins

# GitHub topic searched for further plugin repositories
# Anyone can set a topic on GitHub; it is a discovery hint, not a trust signal
# Empty disables the search
# Default: pte-plugin
# PTE_PLUGIN_DISCOVER_TOPIC=pte-plugin

# GitHub owners whose plugins are trusted, separated by commas
# Installing a plugin of another owner requires typing its repository name
# Default: mpilhlt
# PTE_PLUGIN_TRUSTED_OWNERS=mpilhlt

# Hide and refuse plugins of untrusted owners
# Set to 'true', '1', 'yes' or 'on' to enable
# Default: off
# PTE_PLUGIN_TRUSTED_ONLY=1

# GitHub token for plugin discovery (optional, raises the GitHub API rate limit)
# A token without any scopes is sufficient
# GITHUB_TOKEN=

# Note: PTE_WORKER_RECYCLE is set by bin/start-prod; do not set it yourself.

# Plugins can read further settings from environment variables (for example
# GROBID_SERVER_URL or WEBDAV_BASE_URL). They are documented in the README of
# each plugin (https://github.com/mpilhlt/pte-plugins).

# =============================================================================
# Documentation Configuration
# =============================================================================

# Load documentation from GitHub instead of local files
# Set to 'true', '1', or 'yes' to fetch docs from the GitHub repository
# This allows serving updated documentation without rebuilding the application
# Recommended for production to ensure users see the latest documentation
# Default: false (uses local documentation files)
# DOCS_FROM_GITHUB=true

