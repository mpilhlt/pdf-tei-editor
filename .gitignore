# Local files, secrets and caches
.*
!.env.development
!.env.production
!.env.test
!.env.deploy.demo.localhost
!.env.deploy.example.org
*.pyc

# Caches and temp files
*.backup
*.backup.*
*.out
off/
*.stackdump

# installation artifacts
node_modules

# Build artifacts
app/web/pdfjs

# Debug logs
log/

# Application runtime data (unified structure)
data/
data_*/

# Test runtime data (ephemeral, gitignored)
tests/api/runtime/db/
tests/api/runtime/files/
tests/api/runtime/logs/
tests/e2e/runtime/
tests/**/temp-*

# Legacy FastAPI database files (to be removed)
fastapi_app/db/*.json
fastapi_app/db/*.db
fastapi_app/db/*.db-*

# unknown
nul

# Generated documentation
/docs/api/frontend/
/docs/api/backend/
/docs/api/backend-api.json


# pdf-match test pipeline: generated review artifacts (fixtures and cases ARE committed)
tests/pdf-match/pages/
tests/pdf-match/results.json
tests/pdf-match/report.html
tests/pdf-match/rejected.json
# pdf-match test pipeline: source PDFs are fetched on demand, not committed (see sources/README.md)
tests/pdf-match/sources/*.pdf
