{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat ./.env)",
      "Bash(cat ./.env.*)",
      "Bash(cat */.env)",
      "Bash(cat */.env.*)",
      "Bash(head .env)",
      "Bash(head .env.*)",
      "Bash(tail .env)",
      "Bash(tail .env.*)",
      "Bash(less .env)",
      "Bash(less .env.*)",
      "Bash(more .env)",
      "Bash(more .env.*)",
      "Bash(bat .env)",
      "Bash(bat .env.*)",
      "Bash(strings .env)",
      "Bash(xxd .env)",
      "Bash(od .env)"
    ]
  }
}
